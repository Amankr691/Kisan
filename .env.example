# Kisan Web Project - Environment Configuration
FLASK_ENV=development
FLASK_APP=app.py
SECRET_KEY=kisan-super-secret-key-2026-prod-secure
JWT_SECRET_KEY=kisan-jwt-secret-key-2026-secure

# PostgreSQL Database URL
# Format: postgresql://<username>:<password>@<host>:<port>/<dbname>
# Default fallback to sqlite:///kisan.db if DATABASE_URL is not set
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kisan_db

# Upload Directory & Limits
UPLOAD_FOLDER=static/uploads
MAX_CONTENT_LENGTH=16777216
